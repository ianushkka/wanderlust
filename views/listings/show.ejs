<% layout("/layouts/boilerplate.ejs") %>

<div class="row">
    <div class="col-12  col-md-8 offset-md-2 "> 
        <h3 class="mb-3"><%= currentListing.title %></h3>
        <div class="card show-card">
            <img src="<%= currentListing.image.url %>" class="card-img-top show-img" alt="<%= currentListing.title %>"> 
            <div class="card-body px-2">
                <p class="card-text mb-1"><%= currentListing.description %></p>
                <p class="card-text mb-1"><b>&#8377;<%= currentListing.price.toLocaleString("en-IN") %></b> / night</p>
                <p class="card-text text-muted"><%= currentListing.location %>, <%= currentListing.country %></p>
            </div>


        </div>

        <a href="/listings/<%= currentListing._id%>/edit" class="edit-listing-btn">
            <button>Edit</button>
        </a>
        <br>
        <form action="/listings/<%= currentListing._id %>?_method=DELETE" method="POST" class="delete-listing-btn">    
            <button>Delete</button>
        </form>
        
    </div>

</div>