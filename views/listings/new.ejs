<% layout("/layouts/boilerplate.ejs") %>

<div class="row">
    <div class="col-12 col-md-8 offset-md-2">

        <h3>Create a new listing</h3>
        <form method="POST" action="/listings" class="needs-validation" novalidate>

            <div class="row mb-3">
                <label for="title" class="col-sm-3 col-form-label  text-sm-end">Title</label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" id="title" name="listing[title]" required>
                    <div class="invalid-feedback">Please enter a title.</div>
                </div>
            </div> 
            <div class="row mb-3">
                <label for="description" class="col-sm-3 col-form-label  text-sm-end">Description</label>
                <div class="col-sm-9">
                    <textarea class="form-control optional" id="description" name="listing[description]" rows="4"></textarea>
                </div>
            </div>
            <div class="row mb-3">
                <label for="imageURL" class="col-sm-3 col-form-label  text-sm-end">Image URL</label>
                <div class="col-sm-9">
                    <input type="url" class="form-control optional" id="imageURL" name="listing[image][url]">
                    <div class="invalid-feedback">Please enter a valid URL, or leave it blank.</div>
                </div>
            </div>
            <div class="row mb-3">
                <label for="price" class="col-sm-3 col-form-label  text-sm-end" >Price</label>
                <div class="col-sm-3 col-md-3">
                    <input type="number" class="form-control" id="price" name="listing[price]" required min="0">
                    <div class="invalid-feedback">Please enter a valid price.</div>
                </div>
                <label for="location" class="col-sm-2 col-form-label  text-sm-end">Location</label>
                <div class="col-sm-3 col-md-4">
                    <input type="text" class="form-control" id="location" name="listing[location]" required>
                    <div class="invalid-feedback">Please enter a location.</div>
                </div>
            </div>
            <div class="row mb-3">
                <label for="country" class="col-sm-3 col-form-label  text-sm-end">Country</label>
                <div class="col-sm-6">
                    <input type="text" class="form-control" id="country" name="listing[country]" required>
                    <div class="invalid-feedback">Please enter a country.</div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-9 offset-sm-3">
                    <button type="submit" class="btn add-btn ">Add listing</button>
                </div>
            </div>
            

        </form>

    </div>
</div>