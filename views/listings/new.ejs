<% layout("/layouts/boilerplate.ejs") %>

<div class="row">
    <div class="col-12 col-md-8 offset-md-2">

        <h3>Create a new listing</h3>
        <form method="POST" action="/listings">

            <div class="row mb-3">
                <label for="title" class="col-sm-3 col-form-label  text-sm-end">Title</label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" id="title" name="listing[title]">
                </div>
            </div> 
            <div class="row mb-3">
                <label for="description" class="col-sm-3 col-form-label  text-sm-end">Description</label>
                <div class="col-sm-9">
                    <textarea class="form-control" id="description" name="listing[description]" rows="4"></textarea>
                </div>
            </div>
            <div class="row mb-3">
                <label for="imageURL" class="col-sm-3 col-form-label  text-sm-end">Image URL</label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" id="imageURL" name="listing[image][url]">
                </div>
            </div>
            <div class="row mb-3">
                <label for="price" class="col-sm-3 col-form-label  text-sm-end">Price</label>
                <div class="col-sm-3 col-md-3">
                    <input type="number" class="form-control" id="price" name="listing[price]">
                </div>
                <label for="location" class="col-sm-2 col-form-label  text-sm-end">Location</label>
                <div class="col-sm-3 col-md-4">
                    <input type="text" class="form-control" id="location" name="listing[location]">
                </div>
            </div>
            <div class="row mb-3">
                <label for="country" class="col-sm-3 col-form-label  text-sm-end">Country</label>
                <div class="col-sm-6">
                    <input type="text" class="form-control" id="country" name="listing[country]">
                </div>
            </div>

            <div class="row">
                <div class="col-sm-9 offset-sm-3">
                    <button type="submit" class="btn add-btn ">Add listing</button>
                </div>
            </div>
            

        </form>

    </div>
</div>